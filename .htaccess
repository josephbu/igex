<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirect trailing slashes
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [L,R=301]

    # Main rewrite rules
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([0-9]{4})/([a-zA-Z]+)/?$ index.php?year=$1&month=$2 [L,QSA]
    
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([0-9]{4})/?$ index.php?year=$1 [L,QSA]
    
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([0-9]{4})/([a-zA-Z]+)/([a-zA-Z0-9_\-.]+)$ index.php?year=$1&month=$2&image=$3 [L,QSA]
</IfModule>

Options -Indexes
<FilesMatch "\.(ini|log)$">
    Require all denied
</FilesMatch>

# Cache static assets (images, CSS) aggressively for faster browsing
<IfModule mod_expires.c>
    ExpiresActive On
    # Photos: long cache, filenames only change when regenerated
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg  "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/gif  "access plus 1 year"

    # CSS: shorter cache since styles may change more often
    ExpiresByType text/css "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
    # Strong caching headers for photos under /photos
    <FilesMatch "\.(webp|jpe?g|png|gif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Reasonable caching for CSS
    <FilesMatch "\.css$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

